{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.mlx-peer.com"
        }
      ],
      "destination": "https://mlx-peer.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.mlx-peer.com"
        }
      ],
      "destination": "https://mlx-peer.com/:path*",
      "permanent": true
    }
  ]
}
